<?xml version="1.0" encoding="utf-8"?>
<!-- Variante debug uniquement : panel « Champs de test » (spec §15.3). ManifestTest vérifie son absence en release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Répète allowBackup=false du manifeste principal (alerte CodeQL backup-enabled sur ce fichier). -->
    <application android:allowBackup="false">
        <activity
            android:name=".debug.FieldTestsActivity"
            android:exported="true"
            android:label="@string/field_tests_title"
            android:taskAffinity="io.github.superjojo79.nextglyph.fieldtests"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Décor des visuels des stores (StoreMediaTest) : lancé par le test, jamais depuis le lanceur. -->
        <activity
            android:name=".debug.ShowcaseActivity"
            android:exported="true"
            android:label="@string/showcase_label"
            android:taskAffinity="io.github.superjojo79.nextglyph.showcase"
            android:theme="@style/Theme.Showcase"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
